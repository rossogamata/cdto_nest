# Шлях до SQLite-файлу. Локально: file:./dev.db
# У контейнері: file:/app/data/prod.db (директорія /app/data змонтована як volume)
DATABASE_URL="file:./dev.db"

# Секрет для підпису сесій NextAuth. Згенерувати: openssl rand -base64 32
AUTH_SECRET=""

# Потрібно виставити в true, якщо застосунок працює за реверс-проксі (напр. nginx, Caddy)
# AUTH_TRUST_HOST="true"

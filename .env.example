# Шлях до SQLite-файлу. Локально: file:./dev.db
# У контейнері: file:/app/data/prod.db (директорія /app/data змонтована як volume)
DATABASE_URL="file:./dev.db"

# Секрет для підпису сесій NextAuth. Згенерувати: openssl rand -base64 32
AUTH_SECRET=""

# Потрібно для NextAuth у production-режимі (next start), інакше вхід падає
# з помилкою UntrustedHost. У Docker-образі це вже виставлено за замовчуванням.
AUTH_TRUST_HOST="true"
